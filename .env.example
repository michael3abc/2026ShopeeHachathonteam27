# Copy to .env for local use. Values below are local demo configuration only.
API_PROFILE=unconfigured
API_WORKERS_ENABLED=false
RETURN_AGENT_SERVICE_PROFILE=integrated-demo
API_BASE_URL=http://127.0.0.1:8000
API_DATABASE_URL=postgresql+psycopg://return_agent:local-demo@127.0.0.1:5432/return_agent
AGENT_DATABASE_URL=postgresql://return_agent:local-demo@127.0.0.1:5433/return_agent
REDIS_URL=redis://127.0.0.1:6379/0
INTERNAL_SERVICE_TOKEN_FILE=
RETURN_AGENT_MODEL_BASE_URL=
RETURN_AGENT_MODEL_NAME=
RETURN_AGENT_MODEL_API_KEY_FILE=
RETURN_AGENT_MODEL_API_KEY_HOST_FILE=
RETURN_AGENT_MODEL_TIMEOUT_SECONDS=180
RETURN_AGENT_EMBEDDING_BASE_URL=
RETURN_AGENT_EMBEDDING_MODEL=text-embedding-3-large
RETURN_AGENT_EMBEDDING_DIMENSIONS=1536
RETURN_AGENT_EMBEDDING_API_KEY_FILE=
RETURN_AGENT_EMBEDDING_API_KEY_HOST_FILE=
NARRATION_ENABLED=false
