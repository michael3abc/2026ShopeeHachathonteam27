# Copy to .env for local use. Values below are local demo configuration only.
API_PROFILE=unconfigured
AGENT_PROFILE=demo
API_BASE_URL=http://127.0.0.1:8000
API_DATABASE_URL=postgresql+psycopg://return_agent:local-demo@127.0.0.1:5432/return_agent
AGENT_DATABASE_URL=postgresql://return_agent:local-demo@127.0.0.1:5433/return_agent
REDIS_URL=redis://127.0.0.1:6379/0
INTERNAL_SERVICE_TOKEN_FILE=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY_FILE=
MODEL_TIMEOUT_SECONDS=180
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
