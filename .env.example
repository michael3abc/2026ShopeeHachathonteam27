# Supply your gateway CLIENT key in this ignored file, chmod 600.
# Never use a Compass upstream key here.
# Docker Compose mounts config/reviewer-gates.json read-only into API and Agent.
# Change thresholds and version together in that JSON; do not duplicate them here.
RETURN_AGENT_SERVICE_PROFILE=integrated-compass
RETURN_AGENT_MODEL_BASE_URL=https://model.example.invalid/v1
RETURN_AGENT_IMAGE_DIR=.local/image-attachments
RETURN_AGENT_IMAGE_MAX_BYTES=10485760
RETURN_AGENT_IMAGE_MAX_PER_MESSAGE=6
RETURN_AGENT_IMAGE_MAX_PIXELS=25000000
RETURN_AGENT_MODEL_NAME=compass-5.6-luna
RETURN_AGENT_MODEL_API_KEY_FILE=.secrets/compass_gateway_key
RETURN_AGENT_MODEL_API_KEY_HOST_FILE=.secrets/compass_gateway_key
RETURN_AGENT_EMBEDDING_BASE_URL=https://embedding.example.invalid/v1
RETURN_AGENT_EMBEDDING_MODEL=text-embedding-3-large
RETURN_AGENT_EMBEDDING_API_KEY_FILE=.secrets/compass_gateway_key
RETURN_AGENT_EMBEDDING_API_KEY_HOST_FILE=.secrets/compass_gateway_key
RETURN_AGENT_ACTIVITY_QUEUE_SIZE=1024
RETURN_AGENT_NARRATION_TIMEOUT_SECONDS=20
RETURN_AGENT_NARRATION_CONCURRENCY=2
