{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Categories",
      "type": "array"
    },
    "markets": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Markets",
      "type": "array"
    },
    "reason_codes": {
      "items": {
        "enum": [
          "ITEM_DAMAGED",
          "ITEM_NOT_AS_DESCRIBED",
          "MISSING_ITEM",
          "WRONG_ITEM",
          "QUALITY_ISSUE",
          "CHANGED_MIND"
        ],
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "title": "ApplicableConditions",
  "type": "object"
}
