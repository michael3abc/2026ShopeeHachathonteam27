{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clarification_question": {
      "minLength": 1,
      "title": "Clarification Question",
      "type": "string"
    },
    "clarification_round": {
      "minimum": 1,
      "title": "Clarification Round",
      "type": "integer"
    },
    "missing_fields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Missing Fields",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "clarification_round",
    "missing_fields",
    "clarification_question"
  ],
  "title": "ClarificationRequest",
  "type": "object"
}
