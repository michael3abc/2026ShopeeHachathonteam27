{
  "$defs": {
    "EmptyRefundScope": {
      "additionalProperties": false,
      "properties": {
        "line_item_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 0,
          "title": "Line Item Ids",
          "type": "array"
        }
      },
      "required": [
        "line_item_ids"
      ],
      "title": "EmptyRefundScope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "DECLINE",
      "title": "Action",
      "type": "string"
    },
    "amount": {
      "pattern": "^0(?:\\.0+)?$",
      "title": "Amount",
      "type": "string"
    },
    "currency": {
      "maxLength": 3,
      "minLength": 3,
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "policy_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Policy Refs",
      "type": "array"
    },
    "reason_code": {
      "enum": [
        "ITEM_DAMAGED",
        "ITEM_NOT_AS_DESCRIBED",
        "MISSING_ITEM",
        "WRONG_ITEM",
        "QUALITY_ISSUE",
        "CHANGED_MIND"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "refund_scope": {
      "$ref": "#/$defs/EmptyRefundScope"
    }
  },
  "required": [
    "reason_code",
    "policy_refs",
    "amount",
    "currency",
    "action",
    "refund_scope"
  ],
  "title": "DeclineProposedDecision",
  "type": "object"
}
