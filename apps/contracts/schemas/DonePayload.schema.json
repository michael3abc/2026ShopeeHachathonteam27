{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "RESOLVED",
        "ESCALATED"
      ],
      "title": "Status",
      "type": "string"
    },
    "terminal_ref": {
      "minLength": 1,
      "title": "Terminal Ref",
      "type": "string"
    }
  },
  "required": [
    "status",
    "terminal_ref"
  ],
  "title": "DonePayload",
  "type": "object"
}
