{
  "$defs": {
    "ApprovalEvidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "claim_findings": {
          "items": {
            "$ref": "#/$defs/ClaimFinding"
          },
          "minItems": 1,
          "title": "Claim Findings",
          "type": "array"
        },
        "claim_registry_version": {
          "minLength": 1,
          "title": "Claim Registry Version",
          "type": "string"
        },
        "evidence_status": {
          "const": "SUFFICIENT_FOR_APPROVAL",
          "title": "Evidence Status",
          "type": "string"
        }
      },
      "required": [
        "claim_registry_version",
        "claim_findings",
        "evidence_status"
      ],
      "title": "ApprovalEvidenceAssessment",
      "type": "object"
    },
    "ClaimFinding": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "enum": [
            "DELIVERY_CONFIRMED",
            "ORDER_WITHIN_RETURN_WINDOW",
            "SHIPMENT_SEAL_INTACT",
            "ITEM_PHYSICALLY_DAMAGED",
            "DAMAGE_PRESENT_ON_ARRIVAL",
            "ITEM_FUNCTIONALLY_IMPAIRED",
            "ITEM_DIFFERS_FROM_LISTING",
            "WRONG_ITEM_RECEIVED",
            "ITEM_NOT_IN_SHIPMENT",
            "ITEM_UNUSED"
          ],
          "title": "Claim Id",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "CONTRADICTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "supporting_evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Supporting Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "subject",
        "status",
        "explanation"
      ],
      "title": "ClaimFinding",
      "type": "object"
    },
    "DeclineEvidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "claim_findings": {
          "items": {
            "$ref": "#/$defs/ClaimFinding"
          },
          "minItems": 1,
          "title": "Claim Findings",
          "type": "array"
        },
        "claim_registry_version": {
          "minLength": 1,
          "title": "Claim Registry Version",
          "type": "string"
        },
        "evidence_status": {
          "const": "SUFFICIENT_FOR_DECLINE",
          "title": "Evidence Status",
          "type": "string"
        }
      },
      "required": [
        "claim_registry_version",
        "claim_findings",
        "evidence_status"
      ],
      "title": "DeclineEvidenceAssessment",
      "type": "object"
    },
    "EvidenceRequest": {
      "additionalProperties": false,
      "properties": {
        "accepted_evidence_types": {
          "items": {
            "enum": [
              "IMAGE",
              "VIDEO",
              "TEXT",
              "DOCUMENT"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Accepted Evidence Types",
          "type": "array"
        },
        "missing_claims": {
          "items": {
            "$ref": "#/$defs/MissingClaim"
          },
          "minItems": 1,
          "title": "Missing Claims",
          "type": "array"
        },
        "policy_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Policy Refs",
          "type": "array"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "user_message": {
          "minLength": 1,
          "title": "User Message",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "missing_claims",
        "accepted_evidence_types",
        "policy_refs",
        "user_message"
      ],
      "title": "EvidenceRequest",
      "type": "object"
    },
    "InsufficientEvidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "claim_findings": {
          "items": {
            "$ref": "#/$defs/ClaimFinding"
          },
          "minItems": 1,
          "title": "Claim Findings",
          "type": "array"
        },
        "claim_registry_version": {
          "minLength": 1,
          "title": "Claim Registry Version",
          "type": "string"
        },
        "evidence_status": {
          "const": "INSUFFICIENT",
          "title": "Evidence Status",
          "type": "string"
        },
        "missing_evidence_request": {
          "$ref": "#/$defs/EvidenceRequest"
        }
      },
      "required": [
        "claim_registry_version",
        "claim_findings",
        "evidence_status",
        "missing_evidence_request"
      ],
      "title": "InsufficientEvidenceAssessment",
      "type": "object"
    },
    "MissingClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "enum": [
            "DELIVERY_CONFIRMED",
            "ORDER_WITHIN_RETURN_WINDOW",
            "SHIPMENT_SEAL_INTACT",
            "ITEM_PHYSICALLY_DAMAGED",
            "DAMAGE_PRESENT_ON_ARRIVAL",
            "ITEM_FUNCTIONALLY_IMPAIRED",
            "ITEM_DIFFERS_FROM_LISTING",
            "WRONG_ITEM_RECEIVED",
            "ITEM_NOT_IN_SHIPMENT",
            "ITEM_UNUSED"
          ],
          "title": "Claim Id",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "subject"
      ],
      "title": "MissingClaim",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "INSUFFICIENT": "#/$defs/InsufficientEvidenceAssessment",
      "SUFFICIENT_FOR_APPROVAL": "#/$defs/ApprovalEvidenceAssessment",
      "SUFFICIENT_FOR_DECLINE": "#/$defs/DeclineEvidenceAssessment"
    },
    "propertyName": "evidence_status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ApprovalEvidenceAssessment"
    },
    {
      "$ref": "#/$defs/DeclineEvidenceAssessment"
    },
    {
      "$ref": "#/$defs/InsufficientEvidenceAssessment"
    }
  ],
  "title": "EvidenceAssessment"
}
