{
  "$defs": {
    "EvidenceRequest": {
      "additionalProperties": false,
      "properties": {
        "accepted_evidence_types": {
          "items": {
            "enum": [
              "IMAGE",
              "VIDEO",
              "TEXT",
              "DOCUMENT"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Accepted Evidence Types",
          "type": "array"
        },
        "missing_claims": {
          "items": {
            "$ref": "#/$defs/MissingClaim"
          },
          "minItems": 1,
          "title": "Missing Claims",
          "type": "array"
        },
        "policy_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Policy Refs",
          "type": "array"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "user_message": {
          "minLength": 1,
          "title": "User Message",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "missing_claims",
        "accepted_evidence_types",
        "policy_refs",
        "user_message"
      ],
      "title": "EvidenceRequest",
      "type": "object"
    },
    "MissingClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "enum": [
            "DELIVERY_CONFIRMED",
            "ORDER_WITHIN_RETURN_WINDOW",
            "SHIPMENT_SEAL_INTACT",
            "ITEM_PHYSICALLY_DAMAGED",
            "DAMAGE_PRESENT_ON_ARRIVAL",
            "ITEM_FUNCTIONALLY_IMPAIRED",
            "ITEM_DIFFERS_FROM_LISTING",
            "WRONG_ITEM_RECEIVED",
            "ITEM_NOT_IN_SHIPMENT",
            "ITEM_UNUSED"
          ],
          "title": "Claim Id",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "subject"
      ],
      "title": "MissingClaim",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_ref": {
      "minLength": 1,
      "title": "Case Ref",
      "type": "string"
    },
    "kind": {
      "const": "EVIDENCE_REQUEST",
      "title": "Kind",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/EvidenceRequest"
    }
  },
  "required": [
    "kind",
    "case_ref",
    "request"
  ],
  "title": "EvidenceInterruptPayload",
  "type": "object"
}
