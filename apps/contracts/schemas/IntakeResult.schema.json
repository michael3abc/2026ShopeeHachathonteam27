{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_line_item_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Claimed Line Item Ids",
      "type": "array"
    },
    "clarification_question": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clarification Question"
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "missing_fields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "order_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Order Ref"
    },
    "reason_code": {
      "anyOf": [
        {
          "enum": [
            "ITEM_DAMAGED",
            "ITEM_NOT_AS_DESCRIBED",
            "MISSING_ITEM",
            "WRONG_ITEM",
            "QUALITY_ISSUE",
            "CHANGED_MIND"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "reason_summary": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Summary"
    },
    "requested_action": {
      "enum": [
        "REFUND",
        "RETURN_AND_REFUND",
        "EXCHANGE",
        "UNSPECIFIED"
      ],
      "title": "Requested Action",
      "type": "string"
    }
  },
  "required": [
    "completeness",
    "requested_action"
  ],
  "title": "IntakeResult",
  "type": "object"
}
