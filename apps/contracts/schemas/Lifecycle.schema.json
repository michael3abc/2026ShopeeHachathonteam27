{
  "$defs": {
    "ActivityFacts": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "enum": [
                "FULL_REFUND",
                "DECLINE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "finding_statuses": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Finding Statuses",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ActivityFinding"
          },
          "maxItems": 30,
          "title": "Findings",
          "type": "array"
        },
        "next_node": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Node"
        },
        "outcome": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "reason_codes": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Reason Codes",
          "type": "array"
        },
        "references": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "References",
          "type": "array"
        },
        "revision_round": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Round"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "APPROVE",
                "REVISE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        }
      },
      "title": "ActivityFacts",
      "type": "object"
    },
    "ActivityFinding": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "enum": [
            "DELIVERY_CONFIRMED",
            "ORDER_WITHIN_RETURN_WINDOW",
            "SHIPMENT_SEAL_INTACT",
            "ITEM_PHYSICALLY_DAMAGED",
            "DAMAGE_PRESENT_ON_ARRIVAL",
            "ITEM_FUNCTIONALLY_IMPAIRED",
            "ITEM_DIFFERS_FROM_LISTING",
            "WRONG_ITEM_RECEIVED",
            "ITEM_NOT_IN_SHIPMENT",
            "ITEM_UNUSED"
          ],
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Evidence Refs",
          "type": "array"
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "CONTRADICTED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "status"
      ],
      "title": "ActivityFinding",
      "type": "object"
    },
    "ActivityInputs": {
      "additionalProperties": false,
      "properties": {
        "argument_count": {
          "minimum": 0,
          "title": "Argument Count",
          "type": "integer"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "ITEM_DAMAGED",
                "ITEM_NOT_AS_DESCRIBED",
                "MISSING_ITEM",
                "WRONG_ITEM",
                "QUALITY_ISSUE",
                "CHANGED_MIND"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "required_claim_ids": {
          "items": {
            "enum": [
              "DELIVERY_CONFIRMED",
              "ORDER_WITHIN_RETURN_WINDOW",
              "SHIPMENT_SEAL_INTACT",
              "ITEM_PHYSICALLY_DAMAGED",
              "DAMAGE_PRESENT_ON_ARRIVAL",
              "ITEM_FUNCTIONALLY_IMPAIRED",
              "ITEM_DIFFERS_FROM_LISTING",
              "WRONG_ITEM_RECEIVED",
              "ITEM_NOT_IN_SHIPMENT",
              "ITEM_UNUSED"
            ],
            "type": "string"
          },
          "maxItems": 30,
          "title": "Required Claim Ids",
          "type": "array"
        },
        "top_k": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        }
      },
      "required": [
        "argument_count"
      ],
      "title": "ActivityInputs",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "facts": {
      "$ref": "#/$defs/ActivityFacts"
    },
    "inputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivityInputs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.-]+$",
      "title": "Name",
      "type": "string"
    },
    "phase": {
      "enum": [
        "STARTED",
        "COMPLETED",
        "PAUSED",
        "FAILED"
      ],
      "title": "Phase",
      "type": "string"
    },
    "type": {
      "enum": [
        "node",
        "model",
        "tool"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "name",
    "phase"
  ],
  "title": "Lifecycle",
  "type": "object"
}
