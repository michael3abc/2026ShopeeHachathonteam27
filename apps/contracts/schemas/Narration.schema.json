{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error_code": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "source_event_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.-]+$",
      "title": "Source Event Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "UNAVAILABLE"
      ],
      "title": "Status",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "type": {
      "const": "narration",
      "default": "narration",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "source_event_id",
    "status"
  ],
  "title": "Narration",
  "type": "object"
}
