{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "reason_code": {
      "anyOf": [
        {
          "enum": [
            "RESALE_VALUE_RETAINED",
            "RETURN_REQUIRED_FOR_INSPECTION"
          ],
          "type": "string"
        },
        {
          "enum": [
            "ITEM_UNSALVAGEABLE",
            "HYGIENE_RISK",
            "RETURN_UNECONOMICAL",
            "EVIDENCE_SUFFICIENT_WITHOUT_RETURN"
          ],
          "type": "string"
        }
      ],
      "title": "Reason Code"
    },
    "source": {
      "const": "POLICY",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "source",
    "reason_code"
  ],
  "title": "PolicyReturnDecisionDraft",
  "type": "object"
}
