{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Amount",
      "type": "string"
    },
    "config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "config_version": {
      "minLength": 1,
      "title": "Config Version",
      "type": "string"
    },
    "currency": {
      "maxLength": 3,
      "minLength": 3,
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "HIGH_VALUE_ITEM",
            "CURRENCY_THRESHOLD_UNCONFIGURED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "status": {
      "enum": [
        "PASS",
        "HUMAN_REQUIRED",
        "NOT_APPLICABLE"
      ],
      "title": "Status",
      "type": "string"
    },
    "threshold": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Threshold"
    }
  },
  "required": [
    "config_version",
    "config_hash",
    "status",
    "reason",
    "amount",
    "currency",
    "threshold"
  ],
  "title": "ReviewGateResult",
  "type": "object"
}
