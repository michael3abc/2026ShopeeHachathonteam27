      },
      "required": [
        "evaluation_ref",
        "evaluation_hash",
        "case_ref",
        "order_snapshot_ref",
        "policy_bundle_version",
        "evidence_bundle_hash",
        "findings_ref",
        "item_evaluations",
        "selection",
