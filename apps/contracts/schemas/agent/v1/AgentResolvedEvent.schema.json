          "title": "Currency",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "refund_scope": {
          "$ref": "#/$defs/NonEmptyRefundScope"
        },
        "return_decision": {
          "$ref": "#/$defs/HumanReviewReturnDecision"
        }
      },
      "required": [
        "action",
        "refund_scope",
