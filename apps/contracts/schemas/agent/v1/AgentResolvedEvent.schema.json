          "items": {
            "$ref": "#/$defs/ClaimId"
          },
          "title": "Claim Refs",
          "type": "array"
        },
        "clause_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Clause Refs",
          "type": "array"
        },
        "line_item_id": {
          "minLength": 1,
          "title": "Line Item Id",
          "type": "string"
        },
        "path_id": {
          "$ref": "#/$defs/PolicyPathId"
        },
