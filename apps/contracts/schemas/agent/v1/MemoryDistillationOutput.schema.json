{
  "$defs": {
    "ClaimId": {
      "enum": [
        "DELIVERY_CONFIRMED",
        "ORDER_WITHIN_RETURN_WINDOW",
        "SHIPMENT_SEAL_INTACT",
        "ITEM_PHYSICALLY_DAMAGED",
        "DAMAGE_PRESENT_ON_ARRIVAL",
        "ITEM_FUNCTIONALLY_IMPAIRED",
        "ITEM_DIFFERS_FROM_LISTING",
        "WRONG_ITEM_RECEIVED",
        "ITEM_NOT_IN_SHIPMENT",
        "ITEM_UNUSED"
      ],
      "title": "ClaimId",
      "type": "string"
    },
    "MemoryCandidate": {
      "additionalProperties": false,
      "properties": {
        "applicability_limits": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Applicability Limits",
          "type": "array"
        },
        "claim_registry_version": {
          "minLength": 1,
          "title": "Claim Registry Version",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "prohibited_inferences": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prohibited Inferences",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recommended_behavior": {
          "minLength": 1,
          "title": "Recommended Behavior",
          "type": "string"
        },
        "retrieval_summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Retrieval Summary",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "source_case_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Case Refs",
          "type": "array"
        },
        "source_event_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Event Refs",
          "type": "array"
        },
        "status": {
          "const": "CANDIDATE",
          "title": "Status",
          "type": "string"
        },
        "trigger_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Trigger Conditions",
          "type": "array"
        }
      },
      "required": [
        "memory_id",
        "retrieval_summary",
        "trigger_conditions",
        "recommended_behavior",
        "rationale",
        "source_case_refs",
        "source_event_refs",
        "policy_version",
        "claim_registry_version",
        "scope",
        "confidence",
        "status"
      ],
      "title": "MemoryCandidate",
      "type": "object"
    },
    "MemoryCandidateOutput": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/MemoryCandidate"
        },
        "case_review": {
          "$ref": "#/$defs/MemoryCaseReview"
        },
        "learning": {
          "$ref": "#/$defs/MemoryLearningJudgment"
        },
        "result_type": {
          "const": "CREATE_CANDIDATE",
          "title": "Result Type",
          "type": "string"
        }
      },
      "required": [
        "result_type",
        "case_review",
        "learning",
        "candidate"
      ],
      "title": "MemoryCandidateOutput",
      "type": "object"
    },
    "MemoryCaseReview": {
      "additionalProperties": false,
      "properties": {
        "actions_taken": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Actions Taken",
          "type": "array"
        },
        "downstream_execution_verified": {
          "const": false,
          "default": false,
          "title": "Downstream Execution Verified",
          "type": "boolean"
        },
        "final_action": {
          "$ref": "#/$defs/ResolutionAction"
        },
        "judgment_changes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Judgment Changes",
          "type": "array"
        },
        "key_issue": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Key Issue",
          "type": "string"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "observations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        },
        "source_event_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Source Event Refs",
          "type": "array"
        }
      },
      "required": [
        "key_issue",
        "actions_taken",
        "observations",
        "judgment_changes",
        "final_action",
        "limitations",
        "source_event_refs"
      ],
      "title": "MemoryCaseReview",
      "type": "object"
    },
    "MemoryLearningJudgment": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "VERIFIABLE_ERROR",
            "OPERATIONAL_METHOD",
            "CASE_DISCRETION",
            "EXISTING_RULE",
            "INSUFFICIENT_EVIDENCE",
            "SYSTEM_DEFECT"
          ],
          "title": "Category",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "source_event_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Source Event Refs",
          "type": "array"
        }
      },
      "required": [
        "category",
        "explanation",
        "source_event_refs"
      ],
      "title": "MemoryLearningJudgment",
      "type": "object"
    },
    "MemoryScope": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "$ref": "#/$defs/ClaimId"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "market": {
          "minLength": 1,
          "title": "Market",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "market"
      ],
      "title": "MemoryScope",
      "type": "object"
    },
    "MemorySkipOutput": {
      "additionalProperties": false,
      "properties": {
        "case_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryCaseReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "learning": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryLearningJudgment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "$ref": "#/$defs/MemorySkipReasonCode"
        },
        "result_type": {
          "const": "SKIP",
          "title": "Result Type",
          "type": "string"
        }
      },
      "required": [
        "result_type",
        "reason_code"
      ],
      "title": "MemorySkipOutput",
      "type": "object"
    },
    "MemorySkipReasonCode": {
      "enum": [
        "TRACE_INCOMPLETE",
        "TRACE_LIMIT_EXCEEDED",
        "TRACE_UNSAFE_CONTENT",
        "NO_GENERALIZABLE_LESSON",
        "SYSTEM_DEFECT",
        "NO_FINAL_OUTCOME",
        "CASE_SPECIFIC_ONLY",
        "DATA_ENTRY_ERROR",
        "POLICY_VERSION_UNKNOWN",
        "CLAIM_REGISTRY_VERSION_UNKNOWN",
        "RESTATES_EXISTING_POLICY",
        "CONFLICTS_WITH_POLICY",
        "NO_CONFIRMED_GENERALIZABLE_CORRECTION"
      ],
      "title": "MemorySkipReasonCode",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "ITEM_DAMAGED",
        "ITEM_NOT_AS_DESCRIBED",
        "MISSING_ITEM",
        "WRONG_ITEM",
        "QUALITY_ISSUE",
        "CHANGED_MIND"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ResolutionAction": {
      "enum": [
        "DECLINE",
        "FULL_REFUND"
      ],
      "title": "ResolutionAction",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "CREATE_CANDIDATE": "#/$defs/MemoryCandidateOutput",
      "SKIP": "#/$defs/MemorySkipOutput"
    },
    "propertyName": "result_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/MemoryCandidateOutput"
    },
    {
      "$ref": "#/$defs/MemorySkipOutput"
    }
  ]
}
