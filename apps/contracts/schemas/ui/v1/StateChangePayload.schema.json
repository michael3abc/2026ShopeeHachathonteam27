        "AWAITING_POLICY_CONFIRMATION",
        "AWAITING_RETURN_CONFIRMATION",
        "AWAITING_RETURN",
        "AWAITING_RETURN_INSPECTION",
        "AWAITING_CLARIFICATION",
        "AWAITING_EVIDENCE",
        "AWAITING_HUMAN_REVIEW",
        "EXECUTING",
        "RESOLVED",
        "ESCALATED"
      ],
      "title": "CaseStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "from_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "to_status": {
      "$ref": "#/$defs/CaseStatus"
    }
  },
  "required": [
