{
  "$defs": {
    "ClaimId": {
      "enum": [
        "DELIVERY_CONFIRMED",
        "ORDER_WITHIN_RETURN_WINDOW",
        "SHIPMENT_SEAL_INTACT",
        "ITEM_PHYSICALLY_DAMAGED",
        "DAMAGE_PRESENT_ON_ARRIVAL",
        "ITEM_FUNCTIONALLY_IMPAIRED",
        "ITEM_DIFFERS_FROM_LISTING",
        "WRONG_ITEM_RECEIVED",
        "ITEM_NOT_IN_SHIPMENT",
        "ITEM_UNUSED"
      ],
      "title": "ClaimId",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "ITEM_DAMAGED",
        "ITEM_NOT_AS_DESCRIBED",
        "MISSING_ITEM",
        "WRONG_ITEM",
        "QUALITY_ISSUE",
        "CHANGED_MIND"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "argument_count": {
      "minimum": 0,
      "title": "Argument Count",
      "type": "integer"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "required_claim_ids": {
      "items": {
        "$ref": "#/$defs/ClaimId"
      },
      "maxItems": 30,
      "title": "Required Claim Ids",
      "type": "array"
    },
    "top_k": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Top K"
    }
  },
  "required": [
    "argument_count"
  ],
  "title": "ActivityInputs",
  "type": "object"
}
