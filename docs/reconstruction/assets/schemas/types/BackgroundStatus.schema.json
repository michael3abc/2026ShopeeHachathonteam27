{
  "additionalProperties": false,
  "properties": {
    "error_code": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "status": {
      "enum": [
        "SCHEDULED",
        "STARTED",
        "RETRYING",
        "COMPLETED",
        "SKIPPED",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "type": {
      "const": "background",
      "default": "background",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "BackgroundStatus",
  "type": "object"
}
